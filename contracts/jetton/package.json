{
  "name": "vcoin-ton-jetton",
  "version": "0.1.0",
  "private": true,
  "description": "V COIN fixed-supply TON Jetton contracts",
  "scripts": {
    "build": "tact --config ./tact.config.json",
    "test": "jest --runInBand",
    "verify": "npm run build && npm test",
    "prepare:mainnet": "npm run build && tsc -p tsconfig.deploy.json && node build-js/deploy/prepare-mainnet.js",
    "verify:metadata": "node scripts/verify-metadata.cjs",
    "verify:mainnet-network": "node scripts/verify-mainnet-network.cjs",
    "audit:manifest": "node scripts/create-audit-manifest.cjs"
  },
  "devDependencies": {
    "@tact-lang/compiler": "1.6.13",
    "@ton/core": "0.61.0",
    "@ton/sandbox": "0.38.0",
    "@ton/test-utils": "0.7.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2"
  },
  "overrides": {
    "protobufjs": "^7.6.6",
    "zod": "^4.6.7"
  }
}
