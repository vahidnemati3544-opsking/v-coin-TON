# Copy this file to .env for local development.
# Never commit real credentials, wallet secrets, or private keys.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# Telegram Mini App authentication.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Treasury settlement destination.
# Set the founder-controlled MAINNET TON wallet address in the deployment secret store.
# Do not put the real address in this file or in frontend code.
TON_NETWORK=testnet
FOUNDER_TREASURY_WALLET_ADDRESS=SET_IN_DEPLOYMENT_SECRET_STORE
# Testnet must use a separately verified testnet wallet address.
FOUNDER_TREASURY_WALLET_ADDRESS_TESTNET=SET_IN_DEPLOYMENT_SECRET_STORE

# Sale settlement must remain disabled until the network, destination address,
# Jetton Master, chain payment verification, and delivery workflow are verified.
TREASURY_SETTLEMENT_ENABLED=false
