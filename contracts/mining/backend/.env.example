# Copy this file to .env for local development.
# Never commit real credentials or private keys.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string.
# Replace the placeholders with your local PostgreSQL details.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# Required to enable Telegram Mini App authentication.
# Set this to the token issued by BotFather; never commit the real value.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Exact dApp hostname used by TON Connect ton_proof, e.g. app.example.com.
# Leave unset until the production/staging domain is finalized; verification fails closed.
TON_PROOF_DOMAIN=

# Official deployed V COIN TON Jetton master (override only after verified release review).
VCOIN_JETTON_MASTER_ADDRESS=EQBn4hW8bKhFTSz9riY5q3Pr3SfJmv2VYKZQl_NWMbK--5fP

# Optional network-specific TON Center endpoints and API key.
TON_MAINNET_RPC_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TON_TESTNET_RPC_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TON_RPC_API_KEY=
