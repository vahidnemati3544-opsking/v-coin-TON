# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000
# Use DATABASE_URL OR the PG* variables below.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DB_NAME
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=vcoin_ton
PGUSER=postgres
PGPASSWORD=CHANGE_ME_LOCALLY
PGSSL=false
PGPOOL_MAX=10
